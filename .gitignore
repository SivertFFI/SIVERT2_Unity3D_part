# Unity .gitignore
# Based on GitHub's official Unity.gitignore and common best practices

# OS generated files #
.DS_Store
Thumbs.db

# Visual Studio / Rider
.vs/
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity cache and artifacts
Assets/AssetStoreTools*
Assets/StreamingAssets/aa/*
*.unityproj
*.booproj
*.pidb
*.svd
*.pdb.meta
*.mdb
*.opendb
*.VC.db

# Autogenerated VS/CS project files
*.csproj
*.unityproj
*.sln
*.slnx
*.tmp
*.user
*.userprefs
*.pidb
*.booproj

# Crashlytics / Analytics
crashlytics-build.properties

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata.meta

# Rider project files
*.iml

# Debug / Profiling
*.stackdump
*.memgraph

# Builds
*.apk
*.aab
*.xcodeproj/
*.xcworkspace/
DerivedData/

# Gradle
.gradle/
**/gradle-wrapper.jar
**/gradle-wrapper.properties
**/gradlew
**/gradlew.bat
**/local.properties
**/.gradle/
**/build/

# Android
**/Launcher/build/
**/unityLibrary/build/
**/launcher/build/

# iOS
Pods/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!*.meta

# Keep necessary ProjectSettings and Packages
!/ProjectSettings/
!/Packages/

# Serialized project settings (keep tracked)
!ProjectSettings/ProjectVersion.txt

# Collaborate/Plastic
[Uu]ser[Ss]ettings/

# Logs
*.log

# Simulation outputs
NS3_Logs/
H_Output/

# Large raw data
EMI_Measured_Data/**
!EMI_Measured_Data/*.csv
!EMI_Measured_Data/*.png
