# Normalize line endings for text files
* text=auto eol=lf

# Treat common Unity-generated files as binary
*.fbx binary
*.blend binary
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.anim binary
*.prefab merge=unityyamlmerge eol=lf
*.unity merge=unityyamlmerge eol=lf
*.mat merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf

# If using Git LFS (optional), uncomment these and install LFS
# git lfs install
